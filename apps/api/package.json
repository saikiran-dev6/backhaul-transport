{
  "name": "@backhaul/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/prisma/build/index.js generate --schema ../../prisma/schema.prisma && tsx watch src/server.ts",
    "build": "node ../../node_modules/prisma/build/index.js generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "node ../../node_modules/prisma/build/index.js generate --schema ../../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "db:push": "prisma db push --schema ../../prisma/schema.prisma",
    "db:seed": "tsx ../../prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "express": "4.18.3",
    "ioredis": "^5.4.1",
    "jose": "5.9.6",
    "socket.io": "4.7.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
