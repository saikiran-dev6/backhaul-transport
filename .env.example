# PostgreSQL Production Database URL
DATABASE_URL="postgresql://backhaul:backhaul@localhost:5433/backhaul?schema=public"

# Centralized JWT Authentication Secret
JWT_SECRET="replace-with-a-long-random-production-secret-min-32-chars"

# Public API & Gateway URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Production Allowed Origins for CORS Security
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Razorpay Online Payment Gateway Credentials (Unconfigured by default in Dev/Staging)
RAZORPAY_KEY_ID="rzp_live_replace_with_actual_key"
RAZORPAY_KEY_SECRET="replace_with_actual_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_actual_razorpay_webhook_secret"

# Redis Production Cache & Distributed Rate Limiter
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Media Upload Configuration
UPLOAD_DRIVER="local"
UPLOAD_DIR="public/uploads"
PUBLIC_UPLOAD_BASE_URL=""
